@tool
extends TwitchData

# CLASS GOT AUTOGENERATED DON'T CHANGE MANUALLY. CHANGES CAN BE OVERWRITTEN EASILY.

## 
## #/components/schemas/SampleUser
class_name TwitchESSampleUser
	
## An ID that identifies the user.
@export var id: String:
	set(val):
		id = val
		track_data(&"id", val)

## The user's login name.
@export var login: String:
	set(val):
		login = val
		track_data(&"login", val)

## Number of times the channel has been viewed.
@export var view_count: int:
	set(val):
		view_count = val
		track_data(&"view_count", val)

## A float, distinguished from integer only by its format.
@export var ratio: float:
	set(val):
		ratio = val
		track_data(&"ratio", val)

## A number with no format maps to int, not float.
@export var score: int:
	set(val):
		score = val
		track_data(&"score", val)

## Whether the user is currently live.
@export var is_live: bool:
	set(val):
		is_live = val
		track_data(&"is_live", val)

## An object with no properties falls back to Dictionary.
@export var raw_settings: Dictionary:
	set(val):
		raw_settings = val
		track_data(&"raw_settings", val)

## No type at all falls back to Variant.
@export var untyped: Variant:
	set(val):
		untyped = val
		track_data(&"untyped", val)



## Constructor with all required fields.
static func create(_id: String, _login: String) -> TwitchESSampleUser:
	var twitch_es_sample_user: TwitchESSampleUser = TwitchESSampleUser.new()
	twitch_es_sample_user.id = _id
	twitch_es_sample_user.login = _login
	return twitch_es_sample_user


static func from_json(d: Dictionary) -> TwitchESSampleUser:
	var result: TwitchESSampleUser = TwitchESSampleUser.new()
	if d.get("id", null) != null:
		result.id = d["id"]
	if d.get("login", null) != null:
		result.login = d["login"]
	if d.get("view_count", null) != null:
		result.view_count = d["view_count"]
	if d.get("ratio", null) != null:
		result.ratio = d["ratio"]
	if d.get("score", null) != null:
		result.score = d["score"]
	if d.get("is_live", null) != null:
		result.is_live = d["is_live"]
	if d.get("raw_settings", null) != null:
		result.raw_settings = d["raw_settings"]
	if d.get("untyped", null) != null:
		result.untyped = d["untyped"]
	return result
