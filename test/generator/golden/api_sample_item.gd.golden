@tool
extends TwitchData

# CLASS GOT AUTOGENERATED DON'T CHANGE MANUALLY. CHANGES CAN BE OVERWRITTEN EASILY.

## 
## #/components/schemas/SampleItem
class_name TwitchSampleItem
	
## The item's ID.
@export var id: String:
	set(val):
		id = val
		track_data(&"id", val)

## A primitive array — no $ref, so no per-element from_json.
@export var tags: Array[String]:
	set(val):
		tags = val
		track_data(&"tags", val)

## An inline object, which becomes a nested sub-component.
@export var badge: Badge:
	set(val):
		badge = val
		track_data(&"badge", val)



## Constructor with all required fields.
static func create(_id: String) -> TwitchSampleItem:
	var twitch_sample_item: TwitchSampleItem = TwitchSampleItem.new()
	twitch_sample_item.id = _id
	return twitch_sample_item


## Used to transform responses to the current object
static func from_json(d: Dictionary) -> TwitchSampleItem:
	var result: TwitchSampleItem = TwitchSampleItem.new()
	if d.get("id", null) != null:
		result.id = d["id"]
	if d.get("tags", null) != null:
		for value in d["tags"]:
			result.tags.append(value)
		result.track_data(&"tags", result.tags)
	if d.get("badge", null) != null:
		result.badge = Badge.from_json(d["badge"])
	return result



## An inline object, which becomes a nested sub-component.
## #/components/schemas/SampleItem/Badge
class Badge extends TwitchData:

	## The badge set.
	@export var set_id: String:
		set(val):
			set_id = val
			track_data(&"set_id", val)
	
	## The badge version.
	@export var version: String:
		set(val):
			version = val
			track_data(&"version", val)
	
	
	
	## Constructor with all required fields.
	static func create() -> Badge:
		var badge: Badge = Badge.new()
		return badge
	
	
	## Used to transform responses to the current object
	static func from_json(d: Dictionary) -> Badge:
		var result: Badge = Badge.new()
		if d.get("set_id", null) != null:
			result.set_id = d["set_id"]
		if d.get("version", null) != null:
			result.version = d["version"]
		return result
	